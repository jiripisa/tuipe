 1 // parsePort reads a TCP port from text.↵
 2 func parsePort(s string) (int, error) {↵
 3     n, err := strconv.Atoi(strings.TrimSpace(s))↵
 4     if err != nil {↵
 5         return 0, fmt.Errorf("bad port %q: %w", s, err)↵
 6     }↵
 7     if n < 1 || n > 65535 {↵
 8         return 0, errors.New("port out of range")↵
 9     }↵
10     return n, nil↵
11 }↵
12 ↵
13 // Handle answers one request and logs a failure.↵
14 func (s *Server) Get(w http.ResponseWriter, r *Req) {↵
15     if err := s.auth(r); err != nil {↵
16         http.Error(w, "unauthorized", 401)↵
17         return↵
18     }↵
19     port, err := parsePort(r.URL.Query().Get("port"))↵
20     if err != nil {↵
21         http.Error(w, err.Error(), 400)↵
22         return↵
23     }↵
24     fmt.Fprintf(w, "port %d\n", port)↵
25 }
