│ // parsePort reads a TCP port from text.↵                                    │
│ func parsePort(s string) (int, error) {↵                                     │
│     n, err := strconv.Atoi(strings.TrimSpace(s))↵                            │
│     if err != nil {↵                                                         │
│         return 0, fmt.Errorf("bad port %q: %w", s, err)↵                     │
│     }↵                                                                       │
│     if n < 1 || n > 65535 {↵                                                 │
│         return 0, errors.New("port out of range")↵                           │
│     }↵                                                                       │
│     return n, nil↵                                                           │
│ }↵                                                                           │
